# Build multiestágio do serviço principal do BomFilme.
# Referenciado pelo docker-compose.yml da raiz do monorepo; o contexto é ./api.

FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /projeto

# Os poms vêm primeiro e sozinhos: com eles a resolução de dependências fica numa
# camada que só é invalidada quando um pom muda, não a cada alteração de código.
COPY pom.xml .
COPY dominio/pom.xml dominio/
COPY aplicacao/pom.xml aplicacao/
COPY adaptadores/pom.xml adaptadores/
RUN mvn -B -q dependency:go-offline

COPY dominio/src dominio/src
COPY aplicacao/src aplicacao/src
COPY adaptadores/src adaptadores/src
RUN mvn -B package -DskipTests

# `adaptadores` é o módulo que empacota, por ser o único que conhece framework.
FROM eclipse-temurin:25-jre
WORKDIR /aplicacao
RUN groupadd --system bomfilme \
    && useradd --system --gid bomfilme --home-dir /aplicacao --shell /usr/sbin/nologin bomfilme
COPY --from=build --chown=bomfilme:bomfilme /projeto/adaptadores/target/quarkus-app/lib/ ./lib/
COPY --from=build --chown=bomfilme:bomfilme /projeto/adaptadores/target/quarkus-app/*.jar ./
COPY --from=build --chown=bomfilme:bomfilme /projeto/adaptadores/target/quarkus-app/app/ ./app/
COPY --from=build --chown=bomfilme:bomfilme /projeto/adaptadores/target/quarkus-app/quarkus/ ./quarkus/

EXPOSE 8080
ENV QUARKUS_PROFILE=prod
USER bomfilme
# O --add-opens é exigido pelo jboss-threads no Java 24+.
ENTRYPOINT ["java", "--add-opens", "java.base/java.lang=ALL-UNNAMED", "-jar", "/aplicacao/quarkus-run.jar"]
