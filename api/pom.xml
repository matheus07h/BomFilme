<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.ufrn.bomfilme</groupId>
  <artifactId>bomfilme-api</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <!--
    Uma camada por módulo. A direção da dependência é garantida pelo build, não por
    convenção: `dominio` não declara nenhuma dependência, então não existe import de
    framework que compile ali. `aplicacao` só alcança `dominio`, e os adaptadores são
    o único módulo que conhece Quarkus, JPA e HTTP.

        adaptadores  ──►  aplicacao  ──►  dominio

    O teste de arquitetura em `adaptadores` continua valendo: ele cobre o que o Maven
    não cobre, que é a regra entre pacotes dentro do módulo de adaptadores (http não
    fala com banco, por exemplo).
  -->
  <modules>
    <module>dominio</module>
    <module>aplicacao</module>
    <module>adaptadores</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Mantém os nomes dos parâmetros no bytecode: sem isso, as violações de validação
         são reportadas como "arg5" em vez de "tamanho". -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.28.2</quarkus.platform.version>
    <surefire-plugin.version>3.5.2</surefire-plugin.version>
    <archunit.version>1.5.0</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>br.ufrn.bomfilme</groupId>
        <artifactId>dominio</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.ufrn.bomfilme</groupId>
        <artifactId>aplicacao</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
